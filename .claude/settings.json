{
  "enabledPlugins": {
    "foundations@dani-foundations": true
  },
  "extraKnownMarketplaces": {
    "dani-foundations": {
      "source": {
        "source": "github",
        "repo": "danibsheehan/dani-foundations"
      }
    }
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git stash*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npm audit*)",
      "Bash(npx prettier*)",
      "mcp__github__create_pull_request",
      "mcp__github__issue_write",
      "mcp__github__update_pull_request",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__get_me",
      "mcp__github__subscribe_pr_activity",
      "mcp__github__unsubscribe_pr_activity"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(rm -rf*)",
      "mcp__github__merge_pull_request",
      "mcp__github__delete_file"
    ]
  }
}
