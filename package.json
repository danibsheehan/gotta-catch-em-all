{
  "name": "gotta-catch-em-all",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:github-pages": "ng build --configuration production --base-href /gotta-catch-em-all/",
    "build:dev": "ng build --configuration development",
    "serve:dist": "npx --yes http-server dist/gotta-catch-em-all/browser -p 8080 -c-1",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "test:ci": "ng test --watch=false --coverage",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "private": true,
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@angular/animations": "~22.1.3",
    "@angular/common": "~22.1.4",
    "@angular/compiler": "~22.1.4",
    "@angular/core": "~22.1.4",
    "@angular/forms": "~22.1.4",
    "@angular/platform-browser": "~22.1.4",
    "@angular/router": "~22.1.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.0.0",
    "zone.js": "~0.16.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "^4.3.0",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.18",
    "socket.io-parser": "4.2.7",
    "hono": "4.13.0",
    "@hono/node-server": "2.1.0",
    "body-parser": "2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "~22.1.6",
    "@angular/compiler-cli": "~22.1.4",
    "@angular/language-service": "~22.1.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.8"
  }
}
