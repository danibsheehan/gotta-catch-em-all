{
  "name": "gotta-catch-em-all",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:github-pages": "ng build --configuration production --base-href /gotta-catch-em-all/",
    "build:dev": "ng build --configuration development",
    "serve:dist": "npx --yes http-server dist/gotta-catch-em-all/browser -p 8080 -c-1",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "test:ci": "ng test --watch=false --coverage",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~22.0.8",
    "@angular/common": "~22.0.8",
    "@angular/compiler": "~22.0.8",
    "@angular/core": "~22.0.8",
    "@angular/forms": "~22.0.8",
    "@angular/platform-browser": "~22.0.8",
    "@angular/platform-browser-dynamic": "~22.0.8",
    "@angular/router": "~22.0.8",
    "rxjs": "~7.8.2",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "js-yaml": "^4.3.0",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.18"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "~22.0.8",
    "@angular/compiler-cli": "~22.0.8",
    "@angular/language-service": "~22.0.8",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.39.1",
    "jsdom": "^30.0.0",
    "ts-node": "~7.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.8"
  }
}
